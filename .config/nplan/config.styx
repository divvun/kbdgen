platforms (
    {
        platform "rust"
        files (src/**/*.rs examples/**/*.rs tests/**/*.rs crates/**/*.rs crates/**/Cargo.toml crates/**/clippy.toml Cargo.toml Cargo.lock)
        checks {
            format {
                cmd "cargo fmt --all -- --check"
                fix "cargo fmt --all"
            }
            lint {
                cmd "cargo clippy --workspace --all-targets"
            }
            test {
                cmd "cargo nextest run --workspace"
            }
        }
    }
)

commit {
    type-prefix "required"
}

adoption {
    scope "maintenance"
}

stub-scan {
    exempt-paths (crates/kbd-ldml/data/** crates/kbd-ldml/testdata/**)
}

comment-smells {
    exempt-paths (crates/kbd-ldml/data/** crates/kbd-ldml/testdata/**)
}

quality {
    exempt-paths (crates/kbd-ldml/data/** crates/kbd-ldml/testdata/**)
    test-footprint {
        scope crate
    }
}
