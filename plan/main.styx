name kbdgen

source {
    url "git@github.com:divvun/kbdgen.git"
    ref main
}

children (
    {
        id input
        title "Input model and CLI"
        kind @feat
        children (
            {
                id input.layout
                title "Layout YAML model and key notation"
                kind @feat
                implements {
                    main (
                        [spec:kbdgen:def:layout.schema]
                        [spec:kbdgen:def:layout.transforms]
                        [spec:kbdgen:syn:keys.escape]
                        [spec:kbdgen:def:keys.iso-order]
                        [spec:kbdgen:req:layout.schema.targets]
                        [spec:kbdgen:req:layout.transforms.dead-key-entries]
                        [spec:kbdgen:req:keys.iso-order.desktop-layers]
                    )
                }
            }

            {
                id input.bundle
                title ".kbdgen bundle loading, project/target/resources, fetch"
                kind @feat
                implements {
                    main (
                        [spec:kbdgen:def:bundle.structure]
                        [spec:kbdgen:def:bundle.project]
                        [spec:kbdgen:req:bundle.layouts]
                        [spec:kbdgen:def:bundle.resources]
                        [spec:kbdgen:req:bundle.fetch]
                        [spec:kbdgen:req:bundle.layouts.autonym]
                        [spec:kbdgen:req:bundle.structure.targets]
                        [spec:kbdgen:req:bundle.structure.targets.env]
                    )
                }
                deps (input.layout)
            }

            {
                id input.cli
                title "CLI commands and sequential BuildStep pipeline"
                kind @feat
                implements {
                    main ([spec:kbdgen:def:cli.commands] [spec:kbdgen:sem:pipeline.steps])
                }
                deps (input.bundle)
            }

            {
                id input.test-bundle
                title "Fixture-bundle tests for loading, autonym/decimal/BCP47 errors, target stems, icon tags"
                kind @test
                deps (input.bundle input.layout)
            }

            {
                id input.layout-order
                title "Deterministic layout ordering (HashMap) across method.xml, descriptor, Info.plist, KeyboardDefinitions.json"
                kind @fix
                deps (input.bundle)
            }

            {
                id input.windows-layers
                title "Bundle format for Windows extra modifiers/layers, shiftLock/lrmRlm flags, dead-key names and the 49th key (to be expressed in the LDML-aligned format)"
                kind @feat
                deps (targets.windows.dll-gen)
            }
        )
    }

    {
        id targets
        title "Target generators"
        kind @feat
        children (
            {
                id targets.windows
                title Windows
                kind @feat
                children (
                    {
                        id targets.windows.test-golden
                        title "Golden tests for generated KBDTABLES C output"
                        kind @test
                        deps (targets.windows.dll-gen input.layout-order)
                    }

                    {
                        id targets.windows.kbd-spec
                        title "Specify KBDTABLES C emission (kbdc.* rules): structs, modifiers, VK_TO_WCHARS, DEADKEY, LIGATURE, key names, scancode->VK, locale flags, .rc/.def"
                        kind @docs
                        deps (input.layout)
                        sealed true
                        log (
                            {
                                at 2026-10-05T13:08:07.317986Z
                                author "brendan@necessary.nu"
                                kind @status
                                text "Todo → Doing (nplan start)"
                            }

                            {
                                at 2026-10-05T13:31:07.076183Z
                                author "brendan@necessary.nu"
                                kind @status
                                text "Doing → Done (nplan complete)"
                            }
                        )
                    }

                    {
                        id targets.windows.vro-loads
                        title "Regression: Võro layout DLL passes LoadKeyboardLayout on Windows"
                        priority 0
                        kind @test
                        deps (targets.windows.dll-build)
                        log (
                            {
                                at 2026-10-05T13:06:42.808865Z
                                author "brendan@necessary.nu"
                                kind @note
                                text "Evidence (Windows 11 x64, dev-latest outto installer, 2026-10-05): kbdvro.dll present in System32 (8704 B) and SysWOW64 (7680 B); registry Keyboard Layouts\\a0002000 -> kbdvro.dll, Layout Id 00d8, display name @kbdvro.dll,-1000 resolves to 'Võro'; DLL loads as datafile; but LoadKeyboardLayout('a0002000') returns 0, so the layout never appears in the selector, for vro-Latn and en-SE alike. kbdsjd.dll (a0003800) from the same pipeline loads fine. Võro is the only bundle combining dead keys (6 DEADKEY blocks, 00b4 emitted twice) with ligatures (20); sjd has ligatures only, sme dead keys only."
                            }

                            {
                                at 2026-10-05T13:28:03.692362Z
                                author "brendan@necessary.nu"
                                kind @note
                                text "Correction to the evidence note above. Root cause found on jaheira-win11 using an interactive-session LoadKeyboardLayout harness: the installed kbdvro.dll (8704 B, from the dev-latest outto installer) has the pre-47ad789 PE layout (.text RX + .data RW) and fails LoadKeyboardLayout; kbdvro.dll rebuilt from current kbdgen main (single .data RX, 8192 B) loads (HKL f0ff0409). Installed kbdsjd.dll was built 2026-09-15 00:18, after the 47ad789 fix, which is why it loads. The dead-keys+ligatures hypothesis is wrong: Võro's tables load fine; CI built it with a kbdgen predating 47ad789. Immediate remedy: rebuild keyboard-vro with current kbdgen. This node still verifies the generated-C DLL loads."
                            }
                        )
                    }

                    {
                        id targets.windows.dll-spec
                        title "Specify the Windows layout DLL as a no_std Rust crate (kbdl.*): .res writer, chained dead keys, 49th key, extra modifiers/layers, locale flags, names; VM proof of concept"
                        kind @docs
                        deps (input.layout)
                        sealed true
                        log (
                            {
                                at 2026-10-05T13:57:42.406176Z
                                author "brendan@necessary.nu"
                                kind @status
                                text "Todo → Doing (nplan start)"
                            }

                            {
                                at 2026-10-05T14:29:43.623005Z
                                author "brendan@necessary.nu"
                                kind @status
                                text "Doing → Done (nplan complete)"
                            }
                        )
                    }

                    {
                        id targets.windows.dll-gen
                        title "Generate the no_std Rust layout crate, .res and .def; remove KLC generation, klc.* rules and targets.windows.klc"
                        priority 0
                        kind @feat
                        implements {
                            main (
                                [spec:kbdgen:def:kbdl.input]
                                [spec:kbdgen:req:kbdl.input.bundle]
                                [spec:kbdgen:def:kbdl.crate]
                                [spec:kbdgen:syn:kbdl.source]
                                [spec:kbdgen:syn:kbdl.escaping]
                                [spec:kbdgen:def:kbdl.structs]
                                [spec:kbdgen:req:kbdl.structs.pointers]
                                [spec:kbdgen:thm:kbdl.structs.layout]
                                [spec:kbdgen:req:kbdl.export]
                                [spec:kbdgen:def:kbdl.tables]
                                [spec:kbdgen:thm:kbdl.tables.invariants]
                                [spec:kbdgen:def:kbdl.layers]
                                [spec:kbdgen:req:kbdl.modifiers]
                                [spec:kbdgen:req:kbdl.scancodes.extra-modifiers]
                                [spec:kbdgen:sem:kbdl.vk-chars.values]
                                [spec:kbdgen:req:kbdl.vk-chars]
                                [spec:kbdgen:def:kbdl.vk-chars.fixed]
                                [spec:kbdgen:req:kbdl.vk-chars.decimal]
                                [spec:kbdgen:sem:kbdl.caps]
                                [spec:kbdgen:req:kbdl.caps.sgcaps]
                                [spec:kbdgen:req:kbdl.dead-keys]
                                [spec:kbdgen:req:kbdl.dead-keys.table]
                                [spec:kbdgen:req:kbdl.dead-keys.chains]
                                [spec:kbdgen:req:kbdl.dead-keys.diagnostics]
                                [spec:kbdgen:req:kbdl.dead-keys.names]
                                [spec:kbdgen:req:kbdl.ligatures]
                                [spec:kbdgen:thm:kbdl.ligatures.limit]
                                [spec:kbdgen:def:kbdl.scancodes]
                                [spec:kbdgen:def:kbdl.scancodes.extended]
                                [spec:kbdgen:req:kbdl.scancodes.iso]
                                [spec:kbdgen:req:kbdl.key-names]
                                [spec:kbdgen:req:kbdl.locale]
                                [spec:kbdgen:req:kbdl.metadata]
                                [spec:kbdgen:req:kbdl.metadata.bundle]
                                [spec:kbdgen:req:kbdl.metadata.locale]
                                [spec:kbdgen:req:kbdl.resources]
                                [spec:kbdgen:syn:kbdl.resources.format]
                                [spec:kbdgen:syn:kbdl.resources.version]
                                [spec:kbdgen:def:kbdl.resources.fields]
                            )
                        }
                        deps (targets.windows.dll-spec input.layout input.bundle)
                        log (
                            {
                                at 2026-10-05T13:56:44.101262Z
                                author "brendan@necessary.nu"
                                kind @decision
                                text "Operator decisions 2026-10-05: (1) KLC/kbdutool are dropped; the Windows layout DLL is generated as a no_std Rust crate (repr(C) mirrors of kbd.h, Sync pointer wrapper, WOW64 {ptr32,0} slots), linked with rust-lld and the single read+execute .data image flags, with kbdgen writing the .res itself, so builds need only rustup targets on any host. Chosen over generated C (needs MSVC or clang-cl) and over hand-written PE bytes. (2) In scope for the table generator: chained dead keys via DKF_DEAD, the 49th ISO key (B11 -> VK_ABNT_C1), extra modifiers/layers, KLLF_SHIFTLOCK/KLLF_LRM_RLM flags, dead-key and key names. The partial generated-C emitter from the abandoned kbd-c node is saved outside the repo for reference only."
                            }

                            {
                                at 2026-10-05T14:33:11.782107Z
                                author "brendan@necessary.nu"
                                kind @status
                                text "Todo → Doing (nplan start)"
                            }

                            {
                                at 2026-10-05T14:37:29.73124Z
                                author "brendan@necessary.nu"
                                kind @decision
                                text "Operator decision 2026-10-05: keyboard semantics follow macOS. For the layout DLL this means an unmatched dead key emits the dead key's standalone output then the key, implemented by making a key dead character's dead id its standalone output when that is one unique unit (kbdl.dead-keys bumped to +1). Caps behaviour in the DLL keeps Windows' convention (kbdl.caps); the macOS caps rule (Caps+Shift+letter uppercase), no normalization, and backspace-cancels-pending-dead-key apply to the cross-platform engine."
                            }
                        )
                    }

                    {
                        id targets.windows.dll-build
                        title "Build layout DLLs with cargo + rust-lld for x86, x64, arm64 and WOW64; verify the image; drop kbdutool and MSKLC/pahkat"
                        priority 0
                        kind @feat
                        implements {
                            main (
                                [spec:kbdgen:req:kbdl.build.toolchain]
                                [spec:kbdgen:req:kbdl.build]
                                [spec:kbdgen:req:kbdl.build.environment]
                                [spec:kbdgen:req:kbdl.image]
                                [spec:kbdgen:req:kbdl.image.verify]
                                [spec:kbdgen:req:kbdl.wow64]
                            )
                        }
                        deps (targets.windows.dll-gen)
                        log (
                            {
                                at 2026-10-05T14:29:43.589097Z
                                author "brendan@necessary.nu"
                                kind @note
                                text "PoC on jaheira-win11 (2026-10-05): SysWOW64 must hold the 64-bit-table WOW64 variant; a plain i686 build there fails LoadKeyboardLayout, and a missing copy fails with error 126. divvun-actions currently copies the x86 build into wow64/ (actions/keyboard/build/mod.ts createArchitectureDirectories), which must change to ship kbdgen's wow64 output. Also: every installed layout needs a distinct 'Layout Id', or their HKLs collide (kbdi/installer concern). Known-good build command and env scrubbing are in docs/spec/kbdl.md (kbdl.build*)."
                            }

                            {
                                at 2026-10-05T15:01:38.795916Z
                                author "brendan@necessary.nu"
                                kind @status
                                text "Todo → Doing (nplan start)"
                            }
                        )
                    }

                    {
                        id targets.windows.tsf
                        title "TSF text input processor"
                        kind @feat
                        children (
                            {
                                id targets.windows.tsf.design
                                title "TIP architecture: Rust windows crate, substitute-HKL pairing with the layout DLL, x86/x64/arm64 (+ARM64X), registration"
                                kind @docs
                                deps (targets.windows.dll-spec)
                            }

                            {
                                id targets.windows.tsf.compose
                                title "Ligature and dead-key layering beyond what KBDTABLES can express"
                                kind @feat
                                deps (targets.windows.tsf.design targets.windows.dll-build)
                            }

                            {
                                id targets.windows.tsf.emoji
                                title "Emoji keyboard"
                                kind @feat
                                deps (targets.windows.tsf.design)
                            }
                        )
                        log (
                            {
                                at 2026-10-05T13:56:44.140131Z
                                author "brendan@necessary.nu"
                                kind @decision
                                text "Operator decision 2026-10-05: Windows keyboards are layered. The KBDTABLES layout DLL stays the universal base (works on the sign-in screen, secure desktop, elevated apps, consoles, games). A TSF text input processor, paired with the layout DLL as its substitute HKL, adds what tables cannot express: multi-unit dead-key/ligature layering and deep transforms, plus an emoji keyboard. Keyboard installers already bundle divvun-wind; check whether it is the right home for the TIP during tsf.design."
                            }
                        )
                    }
                )
            }

            {
                id targets.macos
                title macOS
                kind @feat
                children (
                    {
                        id targets.macos.keylayout
                        title ".keylayout XML generation"
                        kind @feat
                        implements {
                            main (
                                [spec:kbdgen:def:keylayout.document]
                                [spec:kbdgen:req:keylayout.keymaps]
                                [spec:kbdgen:sem:keylayout.actions]
                                [spec:kbdgen:req:keylayout.transforms]
                                [spec:kbdgen:def:keylayout.document.name]
                                [spec:kbdgen:thm:keylayout.document.id-range]
                                [spec:kbdgen:def:keylayout.keymaps.iso-codes]
                                [spec:kbdgen:req:keylayout.keymaps.tokens]
                                [spec:kbdgen:req:keylayout.actions.dead-key-next]
                            )
                        }
                        deps (input.bundle input.layout targets.macos.test-golden)
                    }

                    {
                        id targets.macos.package
                        title ".bundle, Info.plist, InfoPlist.strings and pkgbuild/productbuild installer"
                        kind @feat
                        implements {
                            main (
                                [spec:kbdgen:req:macbundle.plist]
                                [spec:kbdgen:req:macbundle.installer]
                                [spec:kbdgen:req:macbundle.plist.strings]
                                [spec:kbdgen:req:macbundle.plist.bundle-resources]
                            )
                        }
                        deps (targets.macos.keylayout)
                    }

                    {
                        id targets.macos.test-golden
                        title "Golden-file tests for .keylayout output"
                        kind @test
                        deps (input.layout-order)
                    }

                    {
                        id targets.macos.repeated-dead-key
                        title "Repeated dead key in one layer overwrites earlier positions' transitions"
                        kind @fix
                        deps (targets.macos.keylayout)
                    }
                )
            }

            {
                id targets.ios
                title iOS
                kind @feat
                children (
                    {
                        id targets.ios.keyboard-json
                        title "KeyboardDefinitions.json generation"
                        kind @feat
                        implements {
                            main ([spec:kbdgen:def:ios.keyboard-json] [spec:kbdgen:syn:ios.rows] [spec:kbdgen:req:ios.transforms])
                        }
                        deps (input.bundle input.layout)
                    }

                    {
                        id targets.ios.pbxproj
                        title "pbxproj model, plutil read, serializer"
                        kind @feat
                        implements {
                            main (
                                [spec:kbdgen:def:pbxproj.model]
                                [spec:kbdgen:req:pbxproj.ids]
                                [spec:kbdgen:syn:pbxproj.serialize]
                                [spec:kbdgen:req:pbxproj.quoting]
                                [spec:kbdgen:req:pbxproj.model.read]
                                [spec:kbdgen:sem:pbxproj.model.ordering]
                                [spec:kbdgen:def:pbxproj.serialize.fields]
                                [spec:kbdgen:req:pbxproj.serialize.build-settings]
                                [spec:kbdgen:req:pbxproj.serialize.attributes]
                            )
                        }
                        deps (targets.ios.test-golden)
                    }

                    {
                        id targets.ios.xcode
                        title "Xcode project generation (per-layout targets, localization, entitlements)"
                        kind @feat
                        implements {
                            main (
                                [spec:kbdgen:req:xcode.targets]
                                [spec:kbdgen:req:xcode.localization]
                                [spec:kbdgen:req:xcode.targets.keyboard-plist]
                                [spec:kbdgen:req:xcode.targets.hosting-app]
                            )
                        }
                        deps (targets.ios.pbxproj input.bundle input.layout)
                    }

                    {
                        id targets.ios.toolchain
                        title "Package ids and build chain (clone, fastlane, pod install, xcarchive)"
                        kind @feat
                        implements {
                            main (
                                [spec:kbdgen:req:ios.pkg-ids]
                                [spec:kbdgen:req:ios.build-chain]
                                [spec:kbdgen:def:ios.pkg-ids.all]
                                [spec:kbdgen:req:ios.build-chain.init]
                            )
                        }
                        deps (targets.ios.keyboard-json targets.ios.xcode)
                    }

                    {
                        id targets.ios.test-golden
                        title "Tests for iOS row grammar, transforms, pkg ids, and golden pbxproj round-trip"
                        kind @test
                        deps (targets.ios.keyboard-json input.layout-order)
                    }

                    {
                        id targets.ios.pbxproj-gaps
                        title "Fix FileReference name quoting, implement todo!() attribute arms, replace placeholder comments"
                        kind @fix
                        deps (targets.ios.test-golden)
                    }

                    {
                        id targets.ios.about-path
                        title "Resolve About.txt existence check against output_path instead of CWD"
                        kind @fix
                        deps (targets.ios.xcode)
                    }

                    {
                        id targets.ios.development-team
                        title "Set DEVELOPMENT_TEAM from teamId instead of codeSignId"
                        kind @fix
                        deps (targets.ios.xcode)
                    }
                )
            }

            {
                id targets.android
                title Android
                kind @feat
                children (
                    {
                        id targets.android.layout
                        title "Keyboard XML/rowkeys, assets, method/spellchecker/strings, gradle glue"
                        kind @feat
                        implements {
                            main (
                                [spec:kbdgen:def:android.layout-xml]
                                [spec:kbdgen:req:android.keys]
                                [spec:kbdgen:req:android.transforms]
                                [spec:kbdgen:req:android.metadata]
                                [spec:kbdgen:req:android.gradle]
                                [spec:kbdgen:def:android.layout-xml.name]
                                [spec:kbdgen:req:android.layout-xml.rows]
                                [spec:kbdgen:req:android.keys.number-row]
                                [spec:kbdgen:req:android.metadata.icons]
                                [spec:kbdgen:req:android.metadata.strings]
                            )
                        }
                        deps (input.bundle input.layout targets.android.test-golden)
                    }

                    {
                        id targets.android.toolchain
                        title "giellakbd clone and android-jnilibs download"
                        kind @feat
                        implements {
                            main ([spec:kbdgen:req:android.dependencies] [spec:kbdgen:req:android.dependencies.jnilibs])
                        }
                        deps (input.bundle)
                    }

                    {
                        id targets.android.test-golden
                        title "Golden tests for Android key widths, escaping, moreKeys/hints, names, deadKey roots, asset JSON"
                        kind @test
                        deps (input.layout-order)
                    }

                    {
                        id targets.android.icon-resize
                        title "Fix ImageMagick invocation passing 'convert' as an input file; check exit status"
                        kind @fix
                        deps (targets.android.layout)
                    }
                )
            }

            {
                id targets.chromeos
                title ChromeOS
                kind @feat
                children (
                    {
                        id targets.chromeos.ime
                        title "ChromeOS IME extension (key table, descriptor + JS template, manifest v2, _locales)"
                        kind @feat
                        implements {
                            main (
                                [spec:kbdgen:def:chromeos.keymap]
                                [spec:kbdgen:req:chromeos.descriptor]
                                [spec:kbdgen:req:chromeos.manifest]
                                [spec:kbdgen:sem:chromeos.descriptor.runtime]
                            )
                        }
                        deps (input.bundle input.layout)
                    }

                    {
                        id targets.chromeos.panic-message
                        title "Fix too-few-keys panic wording (hard-codes Windows/Primary); prefer returning an error"
                        kind @fix
