                        log (
                            {
                                at 2026-10-05T14:29:43.589097Z
                                author "brendan@necessary.nu"
                                kind @note
                                text "PoC on jaheira-win11 (2026-10-05): SysWOW64 must hold the 64-bit-table WOW64 variant; a plain i686 build there fails LoadKeyboardLayout, and a missing copy fails with error 126. divvun-actions currently copies the x86 build into wow64/ (actions/keyboard/build/mod.ts createArchitectureDirectories), which must change to ship kbdgen's wow64 output. Also: every installed layout needs a distinct 'Layout Id', or their HKLs collide (kbdi/installer concern). Known-good build command and env scrubbing are in docs/spec/kbdl.md (kbdl.build*)."
                            }

                            {
                                at 2026-10-05T15:01:38.795916Z
                                author "brendan@necessary.nu"
                                kind @status
                                text "Todo → Doing (nplan start)"
                            }
                        )
