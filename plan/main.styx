            {
                id targets.svg
                title "Implement SVG output from template-iso-keyboard.svg, or drop SVG from README and CLI"
                kind @feat
                deps (input.bundle input.layout input.cli)
            }

            {
                id targets.nested-transforms
                title "Recursive transform trees on macOS, iOS and Android (replace todo! sites)"
                kind @feat
                deps (
                    input.layout
                    targets.macos.keylayout
                    targets.ios.keyboard-json
                    targets.android.layout
                    targets.ios.test-golden
                    targets.android.test-golden
                    targets.macos.test-golden
                )
            }
        )
    }

    {
        id quality
        title "Code quality"
        kind @refactor
        children (
            {
                id quality.clippy
                title "Clear clippy warnings and remove dead code (MacOsBuild, unused target fields)"
                kind @refactor
                deps (
                    input.layout
                    input.bundle
                    input.cli
                    targets.windows.dll-gen
                    targets.windows.dll-build
                    targets.macos.package
                    targets.ios.keyboard-json
                    targets.ios.xcode
                    targets.ios.toolchain
                    targets.android.toolchain
                    targets.chromeos.ime
                )
            }

            {
                id quality.deny-warnings
                title "Re-enable -D warnings on the clippy commit gate"
                kind @chore
                deps (quality.clippy)
            }

            {
                id quality.robustness
                title "Robustness: Windows DLL name collisions on 5-char tag prefix, unchecked subprocess exit codes, Android name sanitiser turning _ into x"
                kind @fix
                deps (targets.windows.dll-gen targets.android.layout)
            }
        )
    }
)
