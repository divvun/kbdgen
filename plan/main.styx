                            {
                                id targets.windows.tsf.installer
                                title "Bundle the text service in keyboard installers (divvun-actions)"
                                kind @feat
                                deps (targets.windows.tsf.register targets.windows.tsf.kbdi)
                            }
                        )
                        log (
                            {
                                at 2026-10-05T13:56:44.140131Z
                                author "brendan@necessary.nu"
                                kind @decision
                                text "Operator decision 2026-10-05: Windows keyboards are layered. The KBDTABLES layout DLL stays the universal base (works on the sign-in screen, secure desktop, elevated apps, consoles, games). A TSF text input processor, paired with the layout DLL as its substitute HKL, adds what tables cannot express: multi-unit dead-key/ligature layering and deep transforms, plus an emoji keyboard. Keyboard installers already bundle divvun-wind; check whether it is the right home for the TIP during tsf.design."
                            }

                            {
                                at 2026-10-05T17:08:34.486342Z
                                author "brendan@necessary.nu"
                                kind @decision
                                text "Operator decisions 2026-10-05 after tsf.design: (1) the text service (one shared TIP COM DLL) lives in the kbdgen workspace, not a separate repo; (2) users see one entry per keyboard, the TIP, with the layout DLL only as fallback (sign-in screen, non-TSF contexts); (3) no interim engine: the TIP runs our own keyboard engine, a potential superset of LDML Keyboard 3.0 with kbdgen extensions (ldml.* tree). tsf.md must be revised accordingly once ldml.spec fixes the workspace layout and engine API: drop tsf.engine.interim, retarget the differential test to the real engine, and place the TIP crate per ldml.crate.*. Substitute-HKL pairing does not work for TIPs (verified); the Substitutes-registry workaround is not adopted."
                                after_done true
                            }
                        )
                    }

